"use client";

import { useState, useRef, useCallback } from "react";

// --- Types ---
interface DetectedVariant {
  rsid: string;
  gene: string;
  chromosome: string;
  position: number;
  ref_allele: string;
  alt_allele: string;
  genotype: string;
  star_allele: string;
  clinical_significance: string;
}

interface DrugResult {
  patient_id: string;
  drug: string;
  timestamp: string;
  risk_assessment: {
    risk_label: string;
    confidence_score: number;
    severity: string;
  };
  pharmacogenomic_profile: {
    primary_gene: string;
    diplotype: string;
    phenotype: string;
    detected_variants: DetectedVariant[];
  };
  clinical_recommendation: {
    action: string;
    dosing_guidance: string;
    alternative_drugs: string[];
    monitoring: string;
    cpic_guideline: string;
  };
  llm_generated_explanation: {
    summary: string;
    mechanism: string;
    evidence_level: string;
    references: string[];
  };
  quality_metrics: {
    vcf_parsing_success: boolean;
    variants_detected_count: number;
    gene_coverage: string[];
    analysis_timestamp: string;
  };
}

const SUPPORTED_DRUGS = [
  "CODEINE",
  "WARFARIN",
  "CLOPIDOGREL",
  "SIMVASTATIN",
  "AZATHIOPRINE",
  "FLUOROURACIL",
];

const DRUG_DESCRIPTIONS: Record<string, string> = {
  CODEINE: "Pain relief (opioid)",
  WARFARIN: "Anticoagulant",
  CLOPIDOGREL: "Antiplatelet",
  SIMVASTATIN: "Lipid lowering",
  AZATHIOPRINE: "Immunosuppressant",
  FLUOROURACIL: "Chemotherapy",
};

const API_URL = process.env.NEXT_PUBLIC_API_URL || "http://localhost:8000";

export default function Home() {
  const [file, setFile] = useState<File | null>(null);
  const [selectedDrugs, setSelectedDrugs] = useState<string[]>([]);
  const [results, setResults] = useState<DrugResult[]>([]);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [expandedCards, setExpandedCards] = useState<Set<number>>(new Set());
  const [dragOver, setDragOver] = useState(false);
  const [copied, setCopied] = useState(false);
  const fileInputRef = useRef<HTMLInputElement>(null);

  // --- File handlers ---
  const handleFile = useCallback((f: File) => {
    setError(null);
    if (!f.name.toLowerCase().endsWith(".vcf")) {
      setError("Please upload a valid .vcf file");
      return;
    }
    if (f.size > 50 * 1024 * 1024) { // Increased limit slightly or keep 5MB if backend limited
      setError("File size exceeds 5MB limit");
      return;
    }
    setFile(f);
  }, []);

  const onDrop = useCallback(
    (e: React.DragEvent) => {
      e.preventDefault();
      setDragOver(false);
      if (e.dataTransfer.files.length > 0) handleFile(e.dataTransfer.files[0]);
    },
    [handleFile]
  );

  const onDragOver = useCallback((e: React.DragEvent) => {
    e.preventDefault();
    setDragOver(true);
  }, []);

  const onDragLeave = useCallback(() => setDragOver(false), []);

  // --- Drug toggle ---
  const toggleDrug = (drug: string) => {
    setSelectedDrugs((prev) =>
      prev.includes(drug) ? prev.filter((d) => d !== drug) : [...prev, drug]
    );
  };

  const selectAll = () => {
    setSelectedDrugs(
      selectedDrugs.length === SUPPORTED_DRUGS.length ? [] : [...SUPPORTED_DRUGS]
    );
  };

  // --- Submit ---
  const handleSubmit = async () => {
    if (!file || selectedDrugs.length === 0) return;
    setLoading(true);
    setError(null);
    setResults([]);

    try {
      const formData = new FormData();
      formData.append("vcf_file", file);
      formData.append("drugs", selectedDrugs.join(","));

      const res = await fetch(`${API_URL}/api/analyze`, {
        method: "POST",
        body: formData,
      });

      if (!res.ok) {
        const err = await res.json().catch(() => ({ detail: "Server error" }));
        throw new Error(err.detail || `Error ${res.status}`);
      }

      const data = await res.json();
      setResults(data.results);
    } catch (err) {
      setError(err instanceof Error ? err.message : "Something went wrong");
    } finally {
      setLoading(false);
    }
  };

  // --- Helpers ---
  const getRiskClass = (label: string) => {
    switch (label) {
      case "Safe": return "risk-safe";
      case "Adjust Dosage": return "risk-adjust";
      case "Toxic": return "risk-toxic";
      case "Ineffective": return "risk-ineffective";
      default: return "risk-unknown";
    }
  };

  const getRiskIcon = (label: string) => {
    switch (label) {
      case "Safe": return "✅"; // Trusted check
      case "Adjust Dosage": return "⚠️";
      case "Toxic": return "⛔";
      case "Ineffective": return "📉";
      default: return "❓";
    }
  };

  const toggleExpand = (idx: number) => {
    setExpandedCards((prev) => {
      const next = new Set(prev);
      if (next.has(idx)) next.delete(idx);
      else next.add(idx);
      return next;
    });
  };

  const formatFileSize = (bytes: number) => {
    if (bytes < 1024) return `${bytes} B`;
    if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
    return `${(bytes / (1024 * 1024)).toFixed(2)} MB`;
  };

  const downloadJSON = () => {
    const blob = new Blob([JSON.stringify({ results }, null, 2)], {
      type: "application/json",
    });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = `pharmaguard-results-${new Date().toISOString().slice(0, 10)}.json`;
    a.click();
    URL.revokeObjectURL(url);
  };

  const copyJSON = async () => {
    await navigator.clipboard.writeText(JSON.stringify({ results }, null, 2));
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  };

  const phenotypeFullName: Record<string, string> = {
    PM: "Poor Metabolizer",
    IM: "Intermediate Metabolizer",
    NM: "Normal Metabolizer",
    RM: "Rapid Metabolizer",
    URM: "Ultrarapid Metabolizer",
  };

  return (
    <div className="max-w-4xl mx-auto px-6 py-10 pb-20">

      {/* Header */}
      <div className="mb-12 text-center md:text-left">
        <h1 className="text-3xl font-bold mb-3">Clinical Pharmacogenomics</h1>
        <p className="text-lg text-[var(--text-secondary)] max-w-2xl">
          Upload patient VCF data to generate CPIC-aligned pharmacogenomic risk assessments and dosing recommendations.
        </p>
      </div>

      {/* Input Panel */}
      <div className="card mb-8">
        {/* Step 1: Upload */}
        <div className="mb-8">
          <div className="flex items-center gap-3 mb-4">
            <div className="w-7 h-7 rounded-md bg-[var(--primary-light)] text-[var(--primary)] flex items-center justify-center font-bold text-sm">
              1
            </div>
            <h3 className="text-lg font-semibold">Upload VCF Data</h3>
          </div>

          <div
            className={`drop-zone ${dragOver ? "drag-over" : ""} ${file ? "has-file" : ""}`}
            onDrop={onDrop}
            onDragOver={onDragOver}
            onDragLeave={onDragLeave}
            onClick={() => fileInputRef.current?.click()}
          >
            <input
              ref={fileInputRef}
              type="file"
              accept=".vcf"
              onChange={(e) => {
                if (e.target.files?.[0]) handleFile(e.target.files[0]);
              }}
              className="hidden"
            />
            {file ? (
              <div className="flex flex-col items-center">
                <div className="text-3xl mb-2">📄</div>
                <div className="font-medium text-base text-[var(--text-primary)] mb-1">
                  {file.name}
                </div>
                <div className="text-sm text-[var(--text-secondary)] mb-3">
                  {formatFileSize(file.size)}
                </div>
                <button
                  onClick={(e) => {
                    e.stopPropagation();
                    setFile(null);
                    setResults([]);
                  }}
                  className="text-sm text-[var(--danger)] hover:underline bg-transparent border-none cursor-pointer"
                >
                  Remove file
                </button>
              </div>
            ) : (
              <div className="flex flex-col items-center">
                <div className="text-3xl mb-2 opacity-50">☁️</div>
                <div className="font-medium text-[var(--text-primary)] mb-1">
                  Click to upload or drag & drop VCF
                </div>
                <div className="text-sm text-[var(--text-secondary)]">
                  Supports .vcf format (max 5MB)
                </div>
              </div>
            )}
          </div>
        </div>

        {/* Step 2: Drugs */}
        <div className="mb-8">
          <div className="flex items-center justify-between mb-4">
            <div className="flex items-center gap-3">
              <div className="w-7 h-7 rounded-md bg-[var(--primary-light)] text-[var(--primary)] flex items-center justify-center font-bold text-sm">
                2
              </div>
              <h3 className="text-lg font-semibold">Select Drugs</h3>
            </div>
            <button
              onClick={selectAll}
              className="text-sm text-[var(--primary)] font-medium bg-transparent border-none cursor-pointer hover:text-[var(--primary-hover)]"
            >
              {selectedDrugs.length === SUPPORTED_DRUGS.length
                ? "Deselect all"
                : "Select all"}
            </button>
          </div>

          <div className="flex flex-wrap gap-2">
            {SUPPORTED_DRUGS.map((drug) => (
              <div
                key={drug}
                className={`drug-chip ${selectedDrugs.includes(drug) ? "selected" : ""}`}
                onClick={() => toggleDrug(drug)}
              >
                {drug}
              </div>
            ))}
          </div>
          <div className="mt-2 text-xs text-[var(--text-tertiary)] italic">
            * Select relevant medications to analyze against user genotype.
          </div>
        </div>

        {/* Action */}
        {error && (
          <div className="mb-6 p-4 rounded-lg bg-[var(--danger-bg)] text-[var(--danger-text)] border border-[var(--danger)]/20 text-sm flex items-center gap-2">
            ⚠️ {error}
          </div>
        )}

        <button
          className="btn-primary w-full justify-center text-base py-3"
          onClick={handleSubmit}
          disabled={!file || selectedDrugs.length === 0 || loading}
        >
          {loading ? (
            <><div className="spinner" /> Analyzing...</>
          ) : (
            <>Analyze Clinical Risk</>
          )}
        </button>
      </div>

      {/* Results */}
      {results.length > 0 && (
        <div className="fade-in-up">
          <div className="flex justify-between items-end mb-6">
            <div>
              <h2 className="text-2xl font-bold mb-1">Analysis Report</h2>
              <p className="text-sm text-[var(--text-secondary)]">
                Patient ID: <span className="font-mono text-[var(--text-primary)]">{results[0].patient_id}</span> • {new Date().toLocaleDateString()}
              </p>
            </div>
            <div className="flex gap-2">
              <button className="btn-secondary text-xs" onClick={downloadJSON}>
                📥 Export JSON
              </button>
              <button className="btn-secondary text-xs" onClick={copyJSON}>
                {copied ? "✅ Copied" : "📋 Copy"}
              </button>
            </div>
          </div>

          <div className="grid grid-cols-1 gap-6">
            {results.map((r, i) => (
              <div key={i} className="card fade-in-up" style={{ animationDelay: `${i * 100}ms` }}>
                {/* Result Header */}
                <div className="flex flex-col md:flex-row md:justify-between md:items-start gap-4 mb-6">
                  <div className="flex items-start gap-4">
                    <div className="text-4xl">{getRiskIcon(r.risk_assessment.risk_label)}</div>
                    <div>
                      <h3 className="text-xl font-bold text-[var(--text-primary)]">{r.drug}</h3>
                      <div className="text-sm text-[var(--text-secondary)] mb-2">{DRUG_DESCRIPTIONS[r.drug]}</div>
                      <span className={`risk-badge ${getRiskClass(r.risk_assessment.risk_label)}`}>
                        {r.risk_assessment.risk_label}
                      </span>
                    </div>
                  </div>

                  <div className="flex gap-8 md:text-right text-sm">
                    <div>
                      <div className="text-[var(--text-tertiary)] uppercase text-[10px] font-bold tracking-wider mb-1">Confidence</div>
                      <div className="font-bold text-lg text-[var(--text-primary)]">{(r.risk_assessment.confidence_score * 100).toFixed(0)}%</div>
                    </div>
                    <div>
                      <div className="text-[var(--text-tertiary)] uppercase text-[10px] font-bold tracking-wider mb-1">Gene</div>
                      <div className="font-bold text-lg text-[var(--text-primary)]">{r.pharmacogenomic_profile.primary_gene}</div>
                    </div>
                    <div>
                      <div className="text-[var(--text-tertiary)] uppercase text-[10px] font-bold tracking-wider mb-1">Phenotype</div>
                      <div className="font-bold text-lg text-[var(--text-primary)]">{r.pharmacogenomic_profile.phenotype}</div>
                    </div>
                  </div>
                </div>

                {/* Recommendation Box */}
                <div className="bg-[var(--neutral-bg)] border border-[var(--card-border)] rounded-lg p-4 mb-4">
                  <div className="flex items-center gap-2 mb-2 font-semibold text-[var(--text-primary)]">
                    🩺 Clinical Recommendation
                  </div>
                  <p className="text-sm text-[var(--text-primary)] leading-relaxed">
                    <span className="font-medium block mb-1">{r.clinical_recommendation.action}</span>
                    {r.clinical_recommendation.dosing_guidance}
                  </p>
                </div>

                {/* Details Toggle */}
                <div
                  className="expandable-header border-t border-[var(--card-border)] mt-4 pt-4"
                  onClick={() => toggleExpand(i)}
                >
                  <span>View Clinical Evidence & Variants</span>
                  <span className={`transition-transform duration-200 ${expandedCards.has(i) ? "rotate-180" : ""}`}>
                    ▼
                  </span>
                </div>

                {/* Expanded Content */}
                {expandedCards.has(i) && (
                  <div className="pt-4 animate-in fade-in slide-in-from-top-2 duration-300">
                    <div className="grid md:grid-cols-2 gap-6 mb-6">
                      <div>
                        <h4 className="text-xs font-bold uppercase text-[var(--text-secondary)] tracking-wider mb-2">Mechanism & Evidence</h4>
                        <p className="text-sm text-[var(--text-secondary)] mb-3 leading-relaxed">
                          {r.llm_generated_explanation.mechanism}
                        </p>
                        <div className="text-xs">
                          <span className="text-[var(--text-tertiary)]">Evidence Level: </span>
                          <span className="font-medium text-[var(--primary)]">{r.llm_generated_explanation.evidence_level}</span>
                        </div>
                      </div>
                      <div>
                        <h4 className="text-xs font-bold uppercase text-[var(--text-secondary)] tracking-wider mb-2">Monitoring</h4>
                        <p className="text-sm text-[var(--text-secondary)] leading-relaxed">
                          {r.clinical_recommendation.monitoring}
                        </p>
                        {r.clinical_recommendation.alternative_drugs.length > 0 && (
                          <div className="mt-3">
                            <div className="text-xs text-[var(--text-secondary)] mb-1">Alternatives:</div>
                            <div className="flex flex-wrap gap-1">
                              {r.clinical_recommendation.alternative_drugs.map((alt, j) => (
                                <span key={j} className="text-xs px-2 py-1 bg-[var(--primary-light)] text-[var(--primary-hover)] rounded">
                                  {alt}
                                </span>
                              ))}
                            </div>
                          </div>
                        )}
                      </div>
                    </div>

                    {/* Variants Table */}
                    {r.pharmacogenomic_profile.detected_variants.length > 0 && (
                      <div className="overflow-x-auto border border-[var(--card-border)] rounded-lg">
                        <table className="w-full text-sm text-left">
                          <thead className="bg-[var(--neutral-bg)] text-[var(--text-secondary)] font-medium">
                            <tr>
                              <th className="px-4 py-2 border-b border-[var(--card-border)]">Variant</th>
                              <th className="px-4 py-2 border-b border-[var(--card-border)]">Gene</th>
                              <th className="px-4 py-2 border-b border-[var(--card-border)]">Haplotype</th>
                              <th className="px-4 py-2 border-b border-[var(--card-border)]">Genotype</th>
                              <th className="px-4 py-2 border-b border-[var(--card-border)]">Significance</th>
                            </tr>
                          </thead>
                          <tbody className="divide-y divide-[var(--card-border)]">
                            {r.pharmacogenomic_profile.detected_variants.map((v, k) => (
                              <tr key={k} className="hover:bg-[var(--neutral-bg)] transition-colors">
                                <td className="px-4 py-2 font-mono text-xs text-[var(--primary)]">{v.rsid}</td>
                                <td className="px-4 py-2">{v.gene}</td>
                                <td className="px-4 py-2 font-mono text-xs">{v.star_allele}</td>
                                <td className="px-4 py-2 font-mono text-xs">{v.genotype}</td>
                                <td className="px-4 py-2 text-xs">{v.clinical_significance}</td>
                              </tr>
                            ))}
                          </tbody>
                        </table>
                      </div>
                    )}
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  );
}
